DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# local writes to public/uploads for development.
# Use supabase for Supabase Storage, or vercel_blob for Vercel Blob.
UPLOAD_DRIVER="supabase"
BLOB_READ_WRITE_TOKEN=""

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="employee-leads"

# Security
# Generate a long random value and keep it secret in production.
SECURITY_PEPPER="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
SESSION_HOURS="12"
LOGIN_MAX_FAILED_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
LOGIN_WINDOW_MINUTES="15"
SIGNUP_MAX_ATTEMPTS="20"
SIGNUP_LOCKOUT_MINUTES="30"
SIGNUP_WINDOW_MINUTES="15"
