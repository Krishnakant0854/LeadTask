generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum LeadStatus {
  NEW_LEAD
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model User {
  id           String       @id @default(cuid())
  employeeId   String       @unique
  name         String
  passwordHash String
  role         Role         @default(EMPLOYEE)
  mobile       String?
  email        String?
  state        String?
  photoUrl     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  bankAccount BankAccount?
  customers   Customer[]
  sessions    Session[]
  withdrawals Withdrawal[]

  @@index([role])
  @@index([name])
}

model Customer {
  id           String      @id @default(cuid())
  userId       String
  customerName String
  mobile       String
  product      String
  date         DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  leadProcess LeadProcess?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerName])
  @@index([product])
  @@index([date])
  @@index([userId, product, date])
}

model LeadProcess {
  id              String     @id @default(cuid())
  customerId      String     @unique
  status          LeadStatus @default(NEW_LEAD)
  progress        Int        @default(0)
  income          Decimal    @default(0) @db.Decimal(12, 2)
  rejectionReason String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([status, customerId])
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  bankName      String
  accountNumber String
  ifsc          String
  holderName    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id        String           @id @default(cuid())
  userId    String
  amount    Decimal          @db.Decimal(12, 2)
  date      DateTime         @default(now())
  status    WithdrawalStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([date])
}

model BonusRule {
  id             String   @id @default(cuid())
  product        String   @unique
  bonusAmount    Decimal  @db.Decimal(12, 2)
  thresholdCount Int      @default(10)
  windowDays     Int      @default(2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
}

model Poster {
  id        String   @id @default(cuid())
  imageUrl  String
  linkUrl   String?
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id            String    @id @default(cuid())
  key           String    @unique
  employeeId    String
  ipHash        String
  attempts      Int       @default(0)
  lockedUntil   DateTime?
  lastAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId])
  @@index([lockedUntil])
}
